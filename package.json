{
  "name": "git-forensics-agent",
  "version": "0.1.0",
  "description": "Zero-knowledge forensic case-file agent for adversarial git index corruption and staged-replacement incidents. Cloudflare Agents SDK (Durable Object) + local read-only collector.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "agents": "^0.16.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
